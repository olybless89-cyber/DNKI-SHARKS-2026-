# DNKI SHARKS Accreditation Platform — environment template
# Placeholders only. Never commit real values. In staging/production supply these
# through the hosting provider's secret manager.

# --- Runtime --------------------------------------------------------------
APP_ENV=development                 # development | test | staging | production
DEMO_MODE=true                      # MUST be false outside development (enforced at boot)
HOST=0.0.0.0
PORT=4000
PUBLIC_WEB_URL=http://localhost:3000
TRUST_PROXY=false                   # true when behind a load balancer / CDN
LOG_LEVEL=info

# --- Data ---------------------------------------------------------------
DATABASE_URL=postgres://postgres@localhost:5432/dnki_dev
DATABASE_POOL_MAX=20
# REDIS_URL=redis://localhost:6379   # shared rate-limit store when running several API instances
MIGRATE_ON_START=false

# --- Secrets ------------------------------------------------------------
# 32 random bytes, base64:  openssl rand -base64 32
ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_base64_32
COOKIE_SECURE=false                 # MUST be true outside development (enforced)
SESSION_TTL_HOURS=72
PRIVILEGED_SESSION_TTL_HOURS=10
SESSION_IDLE_MINUTES=120

# --- Membership source --------------------------------------------------
MEMBERSHIP_PROVIDER=registry        # registry (controlled CSV import) | api | manual
# MEMBERSHIP_API_URL=https://membership.example.invalid/v1/
# MEMBERSHIP_API_KEY=REPLACE_ME

# --- Payments -----------------------------------------------------------
PAYMENT_PROVIDER=mock               # mock (sandbox only, refused in production) | paystack | flutterwave
PAYMENT_ORDER_TTL_MINUTES=60
MOCK_PAYMENT_WEBHOOK_SECRET=REPLACE_WITH_openssl_rand_hex_24
# PAYSTACK_SECRET_KEY=sk_test_REPLACE_ME
# PAYSTACK_BASE_URL=https://api.paystack.co
# FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-REPLACE_ME
# FLUTTERWAVE_WEBHOOK_HASH=REPLACE_ME
# FLUTTERWAVE_BASE_URL=https://api.flutterwave.com

# --- Email --------------------------------------------------------------
EMAIL_PROVIDER=log                  # log (development only) | smtp
EMAIL_FROM="DNKI SHARKS Accreditation <no-reply@example.invalid>"
# SMTP_HOST=smtp.example.invalid
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=REPLACE_ME
# SMTP_PASSWORD=REPLACE_ME

# --- Workers ------------------------------------------------------------
WORKER_ENABLED=true                 # outbox delivery + payment reconciliation loops

# --- Web app (apps/web) -------------------------------------------------
API_INTERNAL_URL=http://localhost:4000
